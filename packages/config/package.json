{
  "name": "@bandwise/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tsconfig, ESLint flat config and Vitest preset for the kit packages. Not published.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    }
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
